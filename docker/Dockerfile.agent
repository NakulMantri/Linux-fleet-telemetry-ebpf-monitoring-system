FROM ubuntu:22.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies for C++ compilation and eBPF toolchain
RUN apt-get update && apt-get install -y \
    build-essential \
    clang \
    llvm \
    libbpf-dev \
    libelf-dev \
    zlib1g-dev \
    bpftool \
    iproute2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy agent build configurations and sources
COPY Makefile ./
COPY src/ ./src/

# Compile the agent
RUN make clean && make

# Expose Unix socket volume path
VOLUME /tmp

# Default command to start agent
ENTRYPOINT ["./telemetry-agent"]
CMD ["--socket", "/tmp/telemetry.sock"]
