[Unit]
Description=Lniux Fleet Telemtery & eBPF monitoring system
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/telemetry-agent --socket /tmp/telemetry.sock
Restart=always
RestartSec=3
User=root

# Security capabilities necessary to run eBPF
CapabilityBoundingSet=CAP_BPF CAP_SYS_ADMIN CAP_NET_ADMIN
AmbientCapabilities=CAP_BPF CAP_SYS_ADMIN CAP_NET_ADMIN

# Crucial for older kernels to bypass map memory lock limit checks
LimitMEMLOCK=infinity

# Direct standard output and error to standard service logs
StandardOutput=append:/var/log/telemetry-agent.log
StandardError=append:/var/log/telemetry-agent.log

[Install]
WantedBy=multi-user.target
